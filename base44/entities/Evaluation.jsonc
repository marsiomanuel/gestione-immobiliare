{
  "name": "Evaluation",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "acquisto",
        "vendita"
      ],
      "default": "acquisto"
    },
    "property_name": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "purchase_price": {
      "type": "number",
      "default": 0
    },
    "notary_costs": {
      "type": "number",
      "default": 0
    },
    "renovation_costs": {
      "type": "number",
      "default": 0
    },
    "sale_price": {
      "type": "number",
      "default": 0
    },
    "monthly_rent": {
      "type": "number",
      "default": 0
    },
    "condo_fee": {
      "type": "number",
      "default": 0
    },
    "other_costs": {
      "type": "number",
      "default": 0
    },
    "mortgage_amount": {
      "type": "number",
      "default": 0
    },
    "mortgage_rate": {
      "type": "number",
      "default": 3.5
    },
    "mortgage_years": {
      "type": "number",
      "default": 25
    },
    "tax_rate": {
      "type": "number",
      "default": 21
    },
    "years_held": {
      "type": "number",
      "default": 5
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "type",
    "property_name"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}