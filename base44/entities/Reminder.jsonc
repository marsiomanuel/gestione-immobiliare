{
  "name": "Reminder",
  "type": "object",
  "properties": {
    "property_id": {
      "type": "string"
    },
    "property_name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "type": {
      "type": "string",
      "enum": [
        "incasso_affitto",
        "pagamento_spesa",
        "dichiarazione_tasse",
        "scadenza_contratto",
        "altro"
      ],
      "default": "altro"
    },
    "recurring": {
      "type": "boolean",
      "default": false
    },
    "frequency": {
      "type": "string",
      "enum": [
        "mensile",
        "trimestrale",
        "annuale",
        "una_tantum"
      ],
      "default": "una_tantum"
    },
    "status": {
      "type": "string",
      "enum": [
        "attivo",
        "completato"
      ],
      "default": "attivo"
    }
  },
  "required": [
    "title",
    "date"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}